PROJECT_NAME="LMS AI Co-Pilot"
ENVIRONMENT="production"

# LLM Providers (Required)
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_co_pilot"

# Qdrant Vector DB
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="learning_content"

# LMS Backend Integration & JWT Auth
LMS_BASE_URL="http://localhost:8080"
SERVICE_TOKEN="MySuperSecretToken2026"
LMS_WEBHOOK_SECRET="default_webhook_secret_key_2026"
JWT_SECRET="your-lms-jwt-secret-must-match-dotnet"
JWT_ALGORITHM="HS256"

# Caching & Reranker
SEMANTIC_CACHE_ENABLED=true
EXACT_CACHE_ENABLED=true
INTENT_ROUTER_ENABLED=true
RERANKER_MODEL_NAME="miniReranker_arabic_v1"
RATE_LIMIT_ENABLED=true
MOCK_LMS=false
METRICS_ENABLED=true

